{
  "name": "pandas-notebooks",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "pandas",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-toolsai.jupyter",
        "ms-python.python",
        "ms-python.pylint",
        "ms-python.flake8"
      ]
    }
  },
  "remoteUser": "vscode",
  "forwardPorts": [
    5020
  ],
  "shutdownAction": "stopCompose"
}